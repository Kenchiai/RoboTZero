{
  "name": "@esp32sim/studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "notices": "node tools/gen-notices.mjs",
    "board": "node tools/gen-board.mjs",
    "dev": "vite",
    "prebuild": "node tools/gen-notices.mjs --check && node tools/gen-board.mjs --check",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\" \"tools/**/*.test.ts\""
  },
  "dependencies": {
    "svelte": "^5.57.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}

{
  "name": "@esp32sim/studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\" \"tools/**/*.test.ts\"",
    "deploy": "wrangler pages deploy dist --project-name esp32sim --branch main",
    "deploy:preview": "wrangler pages deploy dist --project-name esp32sim --branch preview",
    "smoke": "node tools/smoke.mjs --url http://127.0.0.1:8788 --dist dist"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}

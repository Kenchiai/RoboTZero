{
  "name": "@esp32sim/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "models": "node ../../tools/gen/board-c3-devkit-v1.mjs",
    "sync:core": "node scripts/sync-core.mjs",
    "predev": "npm run models && npm run sync:core",
    "dev": "vite",
